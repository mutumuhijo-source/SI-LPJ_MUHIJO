rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      // Identity verify against admins collection OR bootstrap admin email
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'mutumuhijo@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidUnit(data) {
      return data.keys().hasAll(['name']) && 
             data.keys().size() >= 1 && 
             data.name is string && data.name.size() > 0 && data.name.size() <= 200;
    }

    function isValidReport(data) {
      // List of required fields for a complete report
      let requiredFields = ['unitId', 'unitName', 'activityName', 'executionDate', 'amountReceived', 'totalSpent', 'details', 'status', 'submittedAt', 'submittedBy'];
      return data.keys().hasAll(requiredFields) &&
             data.unitId is string && data.unitId.size() <= 64 &&
             data.unitName is string &&
             data.activityName is string && data.activityName.size() <= 300 &&
             data.executionDate is string && // Simplified format validation
             data.amountReceived is number && data.amountReceived >= 0 &&
             data.totalSpent is number && data.totalSpent >= 0 &&
             data.status in ['pending', 'approved', 'rejected'] &&
             data.submittedAt == request.time &&
             data.submittedBy == request.auth.uid;
    }

    // --- Rules ---

    // Expense types configuration
    match /expense_types/{typeId} {
      allow read, write: if true;
    }

    // App users collection
    match /app_users/{userId} {
      allow read, write: if true;
    }

    // Work units
    match /units/{unitId} {
      allow read, write: if true;
    }

    // Reports collection
    match /reports/{reportId} {
      allow read, write: if true;
    }

    // Admin list
    match /admins/{userId} {
      allow read, write: if true;
    }

    // Global Safety Net (at the end)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
